# Where ParaBank lives. Public demo (default) or a local Docker container.
PARABANK_BASE_URL=https://parabank.parasoft.com/parabank
# PARABANK_BASE_URL=http://localhost:3000/parabank

# true = call POST /services/bank/initializeDB before the run (resets ALL data).
# Only use this against your own Docker instance, never the shared public demo.
PARABANK_RESET_DB=false

# true = allow @destructive tests (admin Clean/Initialize database, JMS toggle, settings changes).
PARABANK_DESTRUCTIVE=false
