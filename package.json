{
  "name": "parabank-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end UI, REST, SOAP, hybrid, data-driven, accessibility and visual tests for Parasoft ParaBank using Playwright + TypeScript",
  "scripts": {
    "test": "playwright test --project=ui-chromium --project=api --project=soap --project=data-driven --project=hybrid --project=a11y",
    "test:smoke": "playwright test --grep @smoke --project=ui-chromium --project=api --project=soap",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:all-browsers": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:ui:headed": "playwright test --project=ui-chromium --headed",
    "test:api": "playwright test --project=api",
    "test:soap": "playwright test --project=soap",
    "test:dd": "playwright test --project=data-driven",
    "test:hybrid": "playwright test --project=hybrid",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:destructive": "cross-env PARABANK_DESTRUCTIVE=true playwright test --grep @destructive",
    "ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "parabank:docker": "docker run -d --name parabank -p 3000:8080 parasoft/parabank:latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "allure": "^3.0.0",
    "allure-playwright": "^3.3.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
